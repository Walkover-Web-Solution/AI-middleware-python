DB_NAME=aimiddleware
DB_USER=postgres
DB_PASS=
DB_HOST=
SecretKey=
MONGODB_CONNECTION_URI=
Encreaption_key=
Secret_IV=
Access_key=
MONGODB_DATABASE_NAME=AI_Middleware
CHATBOTSECRETKEY=
TEMPLATE_ID=
ORG_ID=
PROJECT_ID=
RTLAYER_AUTH=
max_workers=150
REDIS_URI=redis://localhost:6379
CHATBOT_OPTIONS_TEMPLATE_ID=
ENVIRONMENT=LOCAL
QUEUE_CONNECTIONURL=
CONSUMER_STATUS=TRUE
# QUEUE_NAME=AI-MIDDLEWARE-PROD
QUEUE_NAME=LOCAL
PREFETCH_COUNT=40
GCP_CREDENTIALS=
TIMESCALE_SERVICE_URL=
PINECONE_API_KEY=
PINECONE_INDEX=
ADMIN_API_KEY=
PUBLIC_REFERENCEID=
Chatbot_Access_key=
LOG_QUEUE_NAME=AI-Middleware-log-prod
URL=

# Gtwy_Browser: self-hosted Steel browser (https://github.com/steel-dev/steel-browser)
# Private address gtwy uses for Steel REST + CDP. Leave empty to disable the tool.
STEEL_API_URL=http://localhost:3000
# Optional: websocket override for CDP (default derived from STEEL_API_URL, e.g. ws://localhost:3000/)
STEEL_CDP_URL=
# Optional: public origin the USER's browser can reach for the live view (rewrites Steel's debugUrl host)
STEEL_PUBLIC_URL=
# Release the browser after this many idle seconds (900 while a user is logging in via handoff)
GTWY_BROWSER_IDLE_TIMEOUT_SECONDS=300
GTWY_BROWSER_HANDOFF_TIMEOUT_SECONDS=900
GTWY_BROWSER_SNAPSHOT_MAX_CHARS=15000
# How many conversations can hold a browser tab at once inside one Steel container
GTWY_BROWSER_MAX_TABS=10
# Remember a user's logins after their tab closes, so they do not sign in again tomorrow.
# Stored encrypted in Redis and keyed by the request's user_id when one is sent, else by thread.
# Cookies are full account access: leave off unless you accept that.
GTWY_BROWSER_PERSIST_COOKIES=false
GTWY_BROWSER_COOKIE_TTL_DAYS=30
